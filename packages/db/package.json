{
  "name": "@mantle/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./control": "./src/control/index.ts",
    "./control/migrate": "./src/control/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "setup": "tsx src/setup_cli.ts",
    "control:migrate": "tsx src/control_cli.ts migrate",
    "control:seed": "tsx src/control_cli.ts seed",
    "control:generate": "drizzle-kit generate --config drizzle.control.config.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  }
}
