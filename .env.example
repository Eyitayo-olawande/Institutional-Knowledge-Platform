# Local development settings. Copy to .env if you need to change a default.
# Never put real customer data or production credentials here.

# PostgreSQL server (Postgres.app default: your Mac user, no password).
MANTLE_PG_SERVER_URL=postgres://localhost:5432/postgres
MANTLE_PG_CONTROL_DB=mantle_control
MANTLE_PG_DEV_TENANT_DBS=mantle_tenant_alpha,mantle_tenant_beta

# Local folder standing in for S3 compatible storage in development.
MANTLE_FILES_DIR=.data/files

# Sign in secret, 32 characters or more. Required in production; development uses a fixed fallback.
MANTLE_AUTH_SECRET=
